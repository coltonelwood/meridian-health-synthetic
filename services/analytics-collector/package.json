{
  "name": "@meridian-health/analytics-collector",
  "version": "0.8.3",
  "description": "Event ingestion and analytics pipeline - collects user/system events for ClickHouse analytics",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "consumer:start": "ts-node src/workers/kafkaConsumer.ts",
    "migrate:clickhouse": "ts-node scripts/clickhouse-migrations.ts",
    "benchmark": "ts-node scripts/load-test.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^0.2.6",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "lru-cache": "^10.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
