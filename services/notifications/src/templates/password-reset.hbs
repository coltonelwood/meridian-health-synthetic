{{!-- subject: Reset Your Meridian Health Password --}}
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset</title>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; margin: 0; padding: 0; background-color: #f5f5f5; }
    .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
    .header { background-color: #1a5276; color: #ffffff; padding: 24px; text-align: center; }
    .content { padding: 32px 24px; color: #333333; line-height: 1.6; }
    .cta-button { display: inline-block; background-color: #1a5276; color: #ffffff; text-decoration: none; padding: 16px 32px; border-radius: 6px; margin: 24px 0; font-weight: bold; font-size: 16px; }
    .warning-box { background-color: #fef9e7; border: 1px solid #f9e79f; padding: 16px; border-radius: 6px; margin: 20px 0; }
    .footer { background-color: #f8f9fa; padding: 20px 24px; font-size: 12px; color: #888; text-align: center; border-top: 1px solid #eee; }
    .security-notice { background-color: #fadbd8; border: 1px solid #e6b0aa; padding: 12px; border-radius: 4px; margin-top: 24px; font-size: 13px; }
    .hipaa-notice { font-size: 10px; color: #aaa; margin-top: 16px; }
    code { background-color: #f0f0f0; padding: 2px 6px; border-radius: 3px; font-family: monospace; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Meridian Health</h2>
    </div>

    <div class="content">
      <p>Hi {{firstName}},</p>

      <p>We received a request to reset the password for your Meridian Health account. Click the button below to set a new password:</p>

      <div style="text-align: center;">
        <a href="{{resetLink}}" class="cta-button">Reset Your Password</a>
      </div>

      <div class="warning-box">
        <p><strong>This link will expire in {{expiryHours}} hour{{#if (eq expiryHours 1)}}{{else}}s{{/if}}.</strong></p>
        <p>If you didn't request a password reset, you can safely ignore this email. Your password will not be changed.</p>
      </div>

      <p><strong>Password requirements:</strong></p>
      <ul>
        <li>At least 12 characters long</li>
        <li>Must include uppercase and lowercase letters</li>
        <li>Must include at least one number</li>
        <li>Must include at least one special character (@, $, !, %, *, ?, &, #)</li>
        <li>Cannot be any of your last 12 passwords</li>
      </ul>

      <p>If the button above doesn't work, copy and paste this link into your browser:</p>
      <p style="word-break: break-all; font-size: 13px; color: #666;">{{resetLink}}</p>

      <div class="security-notice">
        <strong>Security Notice:</strong> Meridian Health will never ask for your password via email or phone. If you suspect unauthorized access to your account, please contact our security team immediately at <a href="mailto:security@meridianhealth.io">security@meridianhealth.io</a>.
      </div>
    </div>

    <div class="footer">
      <p>Meridian Health Technologies | {{supportPhone}} | {{supportEmail}}</p>
      <p>This is an automated security email. Please do not reply.</p>
      <p class="hipaa-notice">
        &copy; {{currentYear}} Meridian Health Technologies. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>
