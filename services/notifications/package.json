{
  "name": "@meridian-health/notifications-service",
  "version": "1.8.7",
  "description": "Notification service - email, SMS, push for Meridian Health platform",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --forceExit --ci --coverage",
    "lint": "eslint src/ --ext .ts",
    "compile-templates": "node scripts/compile-templates.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "twilio": "^4.19.3",
    "@sendgrid/mail": "^7.7.0",
    "handlebars": "^4.7.8",
    "amqplib": "^0.10.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "bull": "^4.12.0",
    "ioredis": "^5.3.2",
    "html-to-text": "^9.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.14",
    "@types/amqplib": "^0.10.4",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/html-to-text": "^9.0.4",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
