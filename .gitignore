# =============================================================================
# Meridian Health Platform - .gitignore
# =============================================================================

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*

# ---- Build output ----
dist/
build/
out/
*.tsbuildinfo
.turbo/

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
# Keep the example
!.env.example

# HIPAA: Make sure no PHI data files are committed
*.phi
*.phi.json
*.phi.csv
phi_data/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
config/keys/
!config/keys/.gitkeep

# ---- Test & Coverage ----
coverage/
.nyc_output/
test-results/
playwright-report/
junit.xml
*.lcov

# ---- IDE ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Docker ----
docker-compose.local.yml
docker-compose.personal.yml
tmp/

# ---- Python (ML services) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.onnx
!ml/models/.gitkeep
ml/data/raw/
ml/data/processed/
ml/notebooks/.ipynb_checkpoints/

# ---- Terraform ----
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfplan
infra/terraform/plan.out
infra/terraform/.terraform.lock.hcl
*.tfvars
!infra/terraform/envs/*.tfvars.example

# ---- Kubernetes ----
infra/k8s/secrets/
kubeconfig*

# ---- Data dumps & backups ----
*.sql.gz
*.dump
*.bak
data/dumps/
data/backups/
data/exports/

# ---- Logs ----
logs/
*.log

# ---- Generated code ----
libs/api-client/src/generated/
libs/proto/src/generated/
# Keep generated FHIR types (they're checked in for CI speed)
# !libs/fhir-client/src/generated/

# ---- Misc ----
.cache/
.parcel-cache/
.eslintcache
.prettiercache
*.tgz
*.tar.gz
.scannerwork/
sonar-project.properties

# ---- Local scripts / scratch ----
scratch/
_scratch/
personal/
*.local.sh
TODO.local.md
