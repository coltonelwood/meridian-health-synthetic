{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridianhealth.io/schemas/appointment.json",
  "title": "Appointment",
  "description": "Schema for appointment data in the Meridian Health scheduling system.",
  "type": "object",
  "required": ["id", "patient_id", "provider_id", "appointment_type", "start_time", "end_time", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^appt-[a-z0-9-]+$"
    },
    "patient_id": { "type": "string" },
    "patient_mrn": { "type": "string" },
    "patient_name": {
      "type": "object",
      "properties": {
        "first": { "type": "string" },
        "last": { "type": "string" }
      }
    },
    "provider_id": { "type": "string" },
    "provider_npi": { "type": "string", "pattern": "^\\d{10}$" },
    "provider_name": { "type": "string" },
    "facility": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": {
          "type": "object",
          "properties": {
            "street1": { "type": "string" },
            "street2": { "type": ["string", "null"] },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zip": { "type": "string" }
          }
        }
      }
    },
    "appointment_type": {
      "type": "object",
      "required": ["code", "label", "duration_minutes"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["NEW", "FU", "ANNUAL", "URGENT", "TELE", "PROCEDURE", "CONSULT"]
        },
        "label": { "type": "string" },
        "duration_minutes": { "type": "integer", "minimum": 5, "maximum": 240 }
      }
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime with timezone offset. Always store in UTC internally."
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier (e.g., America/New_York)"
    },
    "status": {
      "type": "string",
      "enum": ["requested", "confirmed", "checked_in", "in_progress", "completed", "cancelled", "no_show", "rescheduled"],
      "description": "Current appointment status"
    },
    "booking_method": {
      "type": "string",
      "enum": ["online", "phone", "in_person", "referral", "system"]
    },
    "reason_for_visit": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "chief_complaint": { "type": ["string", "null"] },
    "diagnosis_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "is_telehealth": { "type": "boolean" },
    "telehealth_link": { "type": ["string", "null"], "format": "uri" },
    "referral_number": { "type": ["string", "null"] },
    "prior_authorization": { "type": ["string", "null"] },
    "insurance_verified": { "type": "boolean" },
    "copay_amount": { "type": ["number", "null"], "minimum": 0 },
    "copay_collected": { "type": "boolean" },
    "check_in_time": { "type": ["string", "null"], "format": "date-time" },
    "check_out_time": { "type": ["string", "null"], "format": "date-time" },
    "no_show": { "type": "boolean" },
    "cancellation_reason": { "type": ["string", "null"] },
    "patient_instructions": { "type": ["string", "null"] },
    "internal_notes": {
      "type": ["string", "null"],
      "description": "Staff-only notes. Never exposed to patient-facing APIs."
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["email", "sms", "phone"] },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "sent_at": { "type": ["string", "null"], "format": "date-time" },
          "status": { "type": "string", "enum": ["pending", "sent", "failed", "skipped"] }
        }
      }
    },
    "recurring": {
      "type": ["object", "null"],
      "properties": {
        "frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly", "quarterly"] },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "series_id": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" }
  }
}
