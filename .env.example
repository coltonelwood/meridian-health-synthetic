# =============================================================================
# Meridian Health Platform - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in the values.
# Ask #platform-eng on Slack if you need dev/sandbox credentials.
#
# WARNING: NEVER commit the .env file! It contains secrets.
# HIPAA NOTE: PHI must never appear in environment variables or logs.
#
# Last updated: 2024-08-22 by @jenna.kim
# TODO: We should move secrets to Vault/AWS Secrets Manager instead of env vars (PLAT-3650)
# =============================================================================

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json
# LOG_FORMAT=pretty   # use this for local dev if you want readable logs
PORT=3000

# ---- HIPAA / Compliance ----
HIPAA_AUDIT_ENABLED=true
HIPAA_AUDIT_LOG_DESTINATION=elasticsearch
# HIPAA_AUDIT_LOG_DESTINATION=file    # fallback if ES is down
HIPAA_AUDIT_LOG_PATH=/var/log/meridian/hipaa-audit.log
HIPAA_MIN_PASSWORD_LENGTH=12
HIPAA_SESSION_TIMEOUT_MINUTES=15
HIPAA_MAX_LOGIN_ATTEMPTS=5
HIPAA_REQUIRE_MFA=true
ENCRYPTION_AT_REST_ENABLED=true
ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AES-256 key -- generate with: openssl rand -hex 32

# ---- Database ----
DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_auth
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL_ENABLED=false
# DATABASE_SSL_CA=/path/to/rds-combined-ca-bundle.pem   # needed for staging/prod
DATABASE_STATEMENT_TIMEOUT=30000

# Per-service database URLs (used by migration scripts)
AUTH_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_auth
CLAIMS_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_claims
SCHEDULING_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_scheduling
EHR_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_ehr
ANALYTICS_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_analytics
DOCS_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_docs
NOTIFICATIONS_DATABASE_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_notifications

# Read replica (only used in staging/prod, points to primary in dev)
DATABASE_READ_URL=postgres://meridian:meridian_dev_2024@localhost:5432/meridian_analytics

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=meridian:
REDIS_SESSION_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://meridian:meridian_dev@localhost:5672/meridian
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# RABBITMQ_PREFETCH_COUNT=10   # default is 5

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=meridian
ELASTICSEARCH_AUDIT_INDEX=meridian-hipaa-audit

# ---- MinIO / S3 (Document Storage) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=meridian_minio
S3_SECRET_KEY=meridian_minio_dev
S3_BUCKET=meridian-documents
S3_CLAIM_ATTACHMENTS_BUCKET=meridian-claim-attachments
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# For production, use real AWS S3:
# S3_ENDPOINT=   # leave empty for AWS
# S3_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXXXX
# S3_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Authentication / JWT ----
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-please-change-me
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800
JWT_ISSUER=https://auth.meridianhealth.io
JWT_AUDIENCE=https://api.meridianhealth.io
SMART_FHIR_ENABLED=true

# ---- EHR Integration ----
FHIR_SERVER_BASE_URL=http://localhost:8080/fhir
EPIC_CLIENT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
EPIC_PRIVATE_KEY_PATH=./config/keys/epic-sandbox-private.pem
CERNER_CLIENT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
CERNER_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ATHENA_PRACTICE_ID=000000
ATHENA_CLIENT_ID=XXXXXXXXXXXXXXXX
ATHENA_CLIENT_SECRET=XXXXXXXXXXXXXXXX
# ALLSCRIPTS_APP_NAME=MeridianDev   # deprecated - removed Allscripts integration Q4 2024

# ---- Claims / Clearinghouse ----
CLEARINGHOUSE_URL=https://sandbox.availity.com/api/v1
CLEARINGHOUSE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLEARINGHOUSE_PAYER_ID=00431
EDI_PARSER_WORKERS=2
# WAYSTAR_API_URL=https://api.waystar.com/v1  # old clearinghouse, migrated to Availity
# WAYSTAR_API_KEY=XXXXXXXX                     # keeping for reference

# ---- Notifications ----
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_FROM_EMAIL=noreply@meridianhealth.io
SENDGRID_TEMPLATE_APPOINTMENT_REMINDER=d-XXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_TEMPLATE_CLAIM_STATUS=d-XXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+15551234567
NOTIFICATION_DRY_RUN=true

# ---- Feature Flags ----
# TODO: Migrate these to LaunchDarkly (PLAT-4200)
FF_NEW_CLAIMS_UI=true
FF_BULK_FHIR_EXPORT=true
FF_REFERRAL_SERVICE=false
FF_AI_CLAIM_REVIEW=false
FF_PATIENT_PORTAL_V2=true
FF_TELEHEALTH_INTEGRATION=true
FF_MULTI_TENANT=true
FF_ADVANCED_ANALYTICS=false
# FF_LEGACY_EDI_PARSER=true     # removed in v4.8.0
# FF_OLD_AUTH_FLOW=false          # removed in v4.5.0
# FF_BILLING_SERVICE=false        # billing merged into claims-engine

# ---- External Service URLs ----
AUTH_SERVICE_URL=http://localhost:3001
CLAIMS_SERVICE_URL=http://localhost:3002
EHR_SERVICE_URL=http://localhost:3003
SCHEDULING_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005
DOC_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
# BILLING_SERVICE_URL=http://localhost:3008   # deprecated

# ---- ML / AI ----
ML_SCORING_SERVICE_URL=http://localhost:8000
ML_MODEL_VERSION=claims-fraud-v3
ML_CONFIDENCE_THRESHOLD=0.85
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX   # used for claim summary generation
# OPENAI_MODEL=gpt-4-turbo   # TODO: evaluate moving to a self-hosted model for PHI compliance

# ---- Monitoring / Observability ----
DATADOG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATADOG_APP_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATADOG_SERVICE=meridian-platform
DATADOG_ENV=development
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@sentry.meridianhealth.io/2
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- AWS (for staging/prod) ----
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# EKS_CLUSTER_NAME=meridian-prod
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# ---- Deprecated / Legacy ----
# OLD_MONOLITH_API_URL=http://localhost:4000   # retired Jan 2024
# LEGACY_DB_URL=postgres://legacy:legacy@localhost:5433/meridian_v1   # migrated
# KAFKA_BROKERS=localhost:9092   # replaced by RabbitMQ in v3.0
