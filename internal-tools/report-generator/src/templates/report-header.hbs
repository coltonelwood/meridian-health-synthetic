{{!--
  Report header template used by PDF reports.
  NOTE: PDF generation is currently broken (see claimsReport.ts) so this template
  isn't actually being used. Keeping it here for when we fix the PDF output.
--}}

<div class="report-header" style="border-bottom: 2px solid #1a365d; padding-bottom: 16px; margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      {{!-- TODO: embed actual logo instead of text --}}
      <h1 style="color: #1a365d; font-size: 24px; margin: 0;">
        Meridian Health Technologies
      </h1>
      <h2 style="color: #4a5568; font-size: 18px; margin: 4px 0 0 0;">
        {{reportTitle}}
      </h2>
    </div>
    <div style="text-align: right; color: #718096; font-size: 12px;">
      <p>Generated: {{formatDate generatedAt}}</p>
      <p>Generated by: {{generatedBy}}</p>
      {{#if confidential}}
      <p style="color: #e53e3e; font-weight: bold;">CONFIDENTIAL - DO NOT DISTRIBUTE</p>
      {{/if}}
    </div>
  </div>

  {{#if reportPeriod}}
  <div style="margin-top: 12px; color: #4a5568; font-size: 14px;">
    <strong>Report Period:</strong> {{reportPeriod.start}} to {{reportPeriod.end}}
  </div>
  {{/if}}

  {{#if filters}}
  <div style="margin-top: 8px; color: #718096; font-size: 12px;">
    <strong>Filters:</strong>
    {{#each filters}}
      {{@key}}: {{this}}{{#unless @last}}, {{/unless}}
    {{/each}}
  </div>
  {{/if}}

  {{!-- HIPAA notice for reports containing PHI --}}
  {{#if containsPHI}}
  <div style="margin-top: 12px; padding: 8px 12px; background: #fff5f5; border: 1px solid #fed7d7; border-radius: 4px; font-size: 11px; color: #742a2a;">
    <strong>HIPAA NOTICE:</strong> This report contains Protected Health Information (PHI).
    Handle in accordance with Meridian Health's HIPAA policies. Do not share via unsecured channels.
    Destruction required within 30 days of use per Policy MH-SEC-042.
  </div>
  {{/if}}
</div>
