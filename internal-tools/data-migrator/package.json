{
  "name": "@meridian-internal/data-migrator",
  "version": "1.8.0",
  "private": true,
  "description": "Data migration tool for legacy system imports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "migrate:patients": "ts-node src/index.ts patients",
    "migrate:claims": "ts-node src/index.ts claims",
    "migrate:providers": "ts-node src/index.ts providers",
    "migrate:dry-run": "ts-node src/index.ts --dry-run",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "pg": "^8.11.3",
    "csv-parse": "^5.5.2",
    "progress": "^2.0.3",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0",
    "iconv-lite": "^0.6.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "@types/node": "^20.10.4",
    "@types/progress": "^2.0.7",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11"
  }
}
